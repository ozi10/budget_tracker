generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  categories   Category[]
  transactions Transaction[]
  accounts     Account[]
  transfers    Transfer[]
}

model Category {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  icon          String
  color         String
  type          String // "expense" | "income" | "both"
  locked        Boolean       @default(false)
  monthlyBudget Float? // Monthly spending budget/limit in currency
  transactions  Transaction[]
  createdAt     DateTime      @default(now())

  @@index([userId])
}

model Transaction {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  accountId  String? // Optional: which account was debited/credited
  account    Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  type       String // "expense" | "income"
  amount     Float
  note       String?
  date       DateTime
  source     String   @default("manual") // "manual" | "ai-text" | "ai-photo"
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
}

model Account {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           String        // "bank" | "cash" | "credit_card" | "upi"
  color          String        @default("#1A4D3E")
  icon           String        @default("building")
  openingBalance Float         @default(0) // Starting balance when account was added
  // Credit card specific fields
  creditLimit    Float?        // Credit limit for credit_card type
  billingDay     Int?          // Day of month billing cycle starts (1–28)
  dueDay         Int?          // Day of month payment is due (1–28)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  transfersFrom  Transfer[]    @relation("FromAccount")
  transfersTo    Transfer[]    @relation("ToAccount")

  @@index([userId])
}

model Transfer {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  toAccountId   String
  fromAccount   Account  @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount     Account  @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  amount        Float
  note          String?
  date          DateTime
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([fromAccountId])
  @@index([toAccountId])
}
